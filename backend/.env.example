APP_NAME=BRAVIDO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Sert aux liens envoyés par SMS : doit être joignable depuis un téléphone (IP locale ou domaine)
APP_URL=http://localhost/bravido/backend/public
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bravido
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Numéro vert affiché dans l'app (USR-03)
BRAVIDO_CALL_CENTER=

# Compte administrateur créé par le seeder
ADMIN_EMAIL=admin@bravido.ci
ADMIN_PASSWORD=ChangezMoi!2026
ADMIN_TELEPHONE=+2250700000000

# Code OTP fixe, pris en compte UNIQUEMENT si APP_ENV=local
OTP_CODE_TEST=123456

# SMS : "log" écrit les SMS dans storage/logs, "http" appelle l'agrégateur
SMS_DRIVER=log
SMS_URL=
SMS_TOKEN=
SMS_SENDER=BRAVIDO

# Délai avant SMS de secours si le push n'est pas accusé (secondes)
ALERTE_DELAI_SMS_S=20

# Firebase Cloud Messaging (API HTTP v1) : chemin absolu du JSON du compte de service
FCM_PROJECT_ID=
FCM_CREDENTIALS=
