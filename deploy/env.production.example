# =====================================================================
# BRAVIDO -- .env de PRODUCTION (modele)
# Copier vers /var/www/bravido/backend/.env puis REMPLACER chaque <...>
# Ne JAMAIS commiter le vrai .env. Droits : chmod 640, proprietaire www-data.
# =====================================================================

APP_NAME=BRAVIDO
APP_ENV=production
# Genere par : php artisan key:generate --force   (ne pas la perdre : elle chiffre les fiches medicales ;
# la changer rendrait les donnees chiffrees existantes illisibles)
APP_KEY=
APP_DEBUG=false
# URL publique en HTTPS : utilisee dans les liens envoyes par SMS (suivi de trajet, alerte) et la carte
APP_URL=https://api.<domaine>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# En production : "daily" (un fichier par jour) et niveau "warning" pour ne pas gonfler le disque
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Base de donnees MySQL 8 (creer l'utilisateur dedie, PAS root) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bravido
DB_USERNAME=bravido
DB_PASSWORD=<mot-de-passe-long-et-unique>

# --- Sessions / cache / files d'attente ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies de session marques "secure" (HTTPS uniquement)
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Les alertes SOS passent par la file : le worker supervisor est INDISPENSABLE (jamais "sync" en production)
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Numero vert affiche dans l'application (laisser vide si inexistant)
BRAVIDO_CALL_CENTER=

# --- Compte administrateur (cree/mis a jour par le seeder UNIQUEMENT a la premiere installation) ---
ADMIN_EMAIL=<votre-email-admin>
# A CHANGER : mot de passe long (12+ caracteres). Apres la premiere connexion, changez-le aussi dans l'interface
# ou via tinker (voir README-DEPLOIEMENT.md, etape 17).
ADMIN_PASSWORD=<mot-de-passe-admin-fort>
ADMIN_TELEPHONE=<+225XXXXXXXXXX>

# --- OTP ---
# NE PAS definir OTP_CODE_TEST en production (supprimer la ligne). Il est ignore hors APP_ENV=local,
# mais ne le laissez pas traîner.

# --- SMS ---
# "log" : les SMS sont seulement ecrits dans les journaux (aucun SMS reel) -> OK pour un test sans cout
# "http" : appelle votre agregateur SMS (Orange CI, MTN, Twilio, Infobip...) ; renseigner les 3 lignes suivantes
SMS_DRIVER=log
SMS_URL=
SMS_TOKEN=
SMS_SENDER=BRAVIDO

# Delai avant SMS de secours si le push n'est pas accuse (secondes)
ALERTE_DELAI_SMS_S=20

# --- Firebase Cloud Messaging (notifications push, API HTTP v1) ---
FCM_PROJECT_ID=<id-du-projet-firebase>
# Chemin ABSOLU du JSON du compte de service, televerse par scp (jamais dans git) :
FCM_CREDENTIALS=/var/www/bravido/backend/storage/app/private/firebase-service-account.json
# Ne PAS definir FCM_CA_BUNDLE sous Linux (le bundle cacert.pem n'est utile que sous Windows/WAMP)
# FCM_CA_BUNDLE=

# --- Paiement (abonnement famille) ---
# true = paiement simule (tests uniquement). Mettre false des que de vrais comptes marchands sont configures.
PAIEMENT_SANDBOX=true
# Secret de signature du bac a sable (chaine aleatoire : openssl rand -hex 32)
PAIEMENT_SANDBOX_SECRET=<chaine-aleatoire>
# Comptes marchands : laisser vide tant qu'ils n'existent pas (l'app repond « non configure »)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# --- Divers ---
# OCR des programmes de garde (images) : sous Linux, `apt install tesseract-ocr tesseract-ocr-fra`
# et laisser vide (detecte automatiquement /usr/bin/tesseract).
TESSERACT_PATH=
